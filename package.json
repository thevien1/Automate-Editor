{
  "name": "gpm-automate-editor",
  "version": "3.0.8",
  "description": "GPM Automate Editor - Visual workflow editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/compile-bytenode.cjs",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win"
  },
  "keywords": [
    "gpm",
    "automate",
    "editor",
    "workflow"
  ],
  "author": "GPM Softwares",
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "xlsx": "^0.18.5",
    "bytenode": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "bytenode": "^1.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "javascript-obfuscator": "^5.7.0",
    "postcss": "^8.4.38",
    "rollup-plugin-obfuscator": "^1.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.gpmsoftwares.gpmautomateeditor",
    "productName": "GPM Automate Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
